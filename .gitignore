# OCELOT FRAMEWORK - Git Ignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg-info/
dist/
build/
.eggs/

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# React / Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
.vite/

# SCADA data
data/raw/
*.tmp
*.temp
*.parquet
*.feather

# Logs
*.log
logs/

# Generated files
reports/generated/
exports/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local configuration
*.local
