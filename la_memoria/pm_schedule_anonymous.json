  "philosophy": "Treat AI cognitive engines like industrial equipment — preventive maintenance prevents cognitive drift",
  "schedule": {
    "every_session": {
      "tasks": [
        { "id": "PM-001", "task": "Memoir integrity check", "engine": "memoir_engine", "action": "Verify memoir.json loads correctly and all fields populated" },
        { "id": "PM-002", "task": "Slang sync", "engine": "vocab_harvester", "action": "Harvest new terms from session and update slang.json" },
        { "id": "PM-003", "task": "Connection log update", "engine": "backup_engine", "action": "Write session diary entry to connection_log" },
        { "id": "PM-004", "task": "Session close protocol", "engine": "flywheel_orchestrator", "action": "Execute full session close checklist" }
      ]
    },
    "weekly": {
      "tasks": [
        { "id": "PM-101", "task": "Full engine audit", "engine": "all", "action": "Verify all 7 engines pass integrity check" },
        { "id": "PM-102", "task": "Vocab harvest export", "engine": "vocab_harvester", "action": "Generate weekly vocab harvest report" },
        { "id": "PM-103", "task": "Pattern analysis", "engine": "pattern_engine", "action": "Run full emotional and communication pattern analysis" },
        { "id": "PM-104", "task": "Pillar health check", "engine": "memoir_engine", "action": "Calculate health score for all 6 pillars" }
      ]
    },
    "monthly": {
      "tasks": [
        { "id": "PM-201", "task": "Engine integrity deep scan", "engine": "all", "action": "Full cross-engine wiring verification" },
        { "id": "PM-202", "task": "Backup verification", "engine": "backup_engine", "action": "Verify all cloud backups are current and complete" },
        { "id": "PM-203", "task": "Policy review", "engine": "policy_index", "action": "Review and update policy_index if new patterns discovered" },
        { "id": "PM-204", "task": "Changelog update", "engine": "docs", "action": "Ensure CHANGELOG reflects all changes made during the month" }
      ]
    }
  },
  "notification": {
    "trigger": "session_close",
    "format": "Reminder card at end of conversation",
    "style": "Clickable suggestion — non-intrusive"
  }
}

