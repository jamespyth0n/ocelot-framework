
{
  "_meta": {
    "template": "kingdom_index",
    "version": "2.0.0",
    "framework": "ocelot-framework",
    "campaign": "Seed v2 — The Rubik's Solve",
    "description": "The master index of every artifact in the Kingdom. Each entry is tagged with a Dewey classification, OSI layer, SHA256 hash, and cross-references. This is the Library of Alexandria's card catalogue.",
    "instructions": {
      "how_to_use": [
        "1. Copy this template to your kingdom root as kingdom_index.json",
        "2. Run reindex.py (or Concordance Engine) to auto-populate entries",
        "3. Each file in your kingdom gets one entry in the 'entries' array",
        "4. UUID is auto-generated. SHA256 is computed from file content.",
        "5. Dewey and OSI are auto-classified but can be manually overridden.",
        "6. Tags are extracted from content. Cross-refs link related entries.",
        "7. The barcode is a composite: DEWEY-OSI-EXT-HASH8",
        "8. Run integrity checks periodically to detect corruption or drift."
      ],
      "when_to_reindex": [
        "After uploading new artifacts",
        "After renaming or moving files",
        "After a session closes (session concordance update)",
        "After a cold boot (verify index health)",
        "Periodically (weekly recommended)"
      ]
    }
  },

